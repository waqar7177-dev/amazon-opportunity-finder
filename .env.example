# Copy this file to .env and adjust. Every value is optional.
# .env is git-ignored — never commit real secrets.

# Signs session cookies (CSRF protection). Leave blank and the app generates a
# random key on first start and keeps it in data/secret_key.
SECRET_KEY=

# Where the app listens. Keep 127.0.0.1 so the tool is only reachable from this
# computer. Changing the host to 0.0.0.0 exposes your data to your network.
AOF_HOST=127.0.0.1
AOF_PORT=8877

# Folder for the SQLite database, logs, backups and import previews.
# Default: ./data next to app.py
AOF_DATA_DIR=

# Open the browser automatically when started from run.bat / run.sh (1 or 0).
AOF_OPEN_BROWSER=1

# Extra host names allowed to reach the app (comma separated). Normally empty.
# An entry starting with a dot allows all its subdomains, e.g. .up.railway.app
AOF_ALLOWED_HOSTS=

# --- Optional future integrations (disabled in version 1) -------------------
# Keepa is NOT required. Nothing is sent to Keepa unless both values are set,
# and version 1 ships the Keepa provider as a disabled stub.
KEEPA_API_KEY=
AOF_ENABLE_KEEPA=0
